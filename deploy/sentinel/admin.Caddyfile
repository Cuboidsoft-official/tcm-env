admin.thecodemunk.in {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    handle /api/* {
        reverse_proxy https://api.thecodemunk.in {
            header_up Host api.thecodemunk.in
        }
    }

    handle {
        root * /var/www/tcm-admin/current
        try_files {path} /index.html
        file_server
    }
}
