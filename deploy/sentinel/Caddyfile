app.thecodemunk.in {
    root * /var/www/tcm-web/current
    encode zstd gzip

    @crawlers {
        header_regexp User-Agent "(?i)(whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|discordbot|slackbot)"
    }
    handle @crawlers {
        reverse_proxy https://api.thecodemunk.in {
            header_up Host api.thecodemunk.in
        }
    }

    handle /post/* {
        @crawlerReq header_regexp User-Agent "(?i)(whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|discordbot|slackbot)"
        reverse_proxy @crawlerReq https://api.thecodemunk.in {
            header_up Host api.thecodemunk.in
        }
    }

    handle /p/* {
        @crawlerReq header_regexp User-Agent "(?i)(whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|discordbot|slackbot)"
        reverse_proxy @crawlerReq https://api.thecodemunk.in {
            header_up Host api.thecodemunk.in
        }
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @immutable path /_expo/* /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    try_files {path} /index.html
    file_server
}

:80 {
    root * /var/www/tcm-web/current
    encode zstd gzip
    try_files {path} /index.html
    file_server
}

import /etc/caddy/conf.d/*
