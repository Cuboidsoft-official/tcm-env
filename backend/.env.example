PORT=5000
MONGODB_URI=mongodb://<username>:<url_encoded_password>@host-00-00.example.mongodb.net:27017,host-00-01.example.mongodb.net:27017,host-00-02.example.mongodb.net:27017/tcm_ac?ssl=true&replicaSet=<replica_set>&authSource=admin&retryWrites=true&w=majority
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_openssl_rand_base64_48
# Comma-separated list of allowed browser origins (native apps are not CORS-bound)
CLIENT_ORIGIN=https://app.thecodemunk.in,https://admin.thecodemunk.in,https://thecodemunk.in,https://www.thecodemunk.in
# Production only: uploads must live outside the deployed source tree.
# NODE_ENV=production
# HOST=127.0.0.1
# UPLOADS_DIR=/opt/tcm/uploads
# PUBLIC_ORIGIN=https://api.thecodemunk.in
